@page
@model AnalysisModel

@{
    ViewData["Title"] = "Análisis de Imagen";
}

<link rel="stylesheet" href="~/css/analysis.css" />

<div class="layout">

    <!-- SIDEBAR -->
    <div class="sidebar">

        <div class="logo">Clínica</div>

        <div class="menu">
            <button class="menu-btn">Consultar citas</button>
        </div>

        <div class="logout">
            Logout
        </div>

    </div>


    <!-- CONTENIDO -->
    <div class="analysis-container">

        <h2>Análisis de Imagen</h2>

        <div class="info-bar">
            <span><b>CITA</b> @Model.CodigoCita</span>
            <span><b>PACIENTE</b> @Model.NombrePaciente</span>
            <span><b>FECHA</b> @Model.Fecha</span>
            <span><b>PERSONA RESPONSABLE</b> Médico</span>
        </div>


        <!-- BOTON ARCHIVO -->
        <input type="file" id="imageInput" accept="image/jpeg,image/jpg" hidden>

        <button class="file-btn" onclick="document.getElementById('imageInput').click()">
            Seleccionar archivo JPEG
        </button>


        <!-- IMAGENES -->
        <div class="image-section">

            <div class="eye-box">

                <h3>Ojo Izquierdo</h3>
                <div class="image-preview" id="previewLeft"></div>

            </div>


            <div class="eye-box">

                <h3>Ojo Derecho</h3>
                <div class="image-preview" id="previewRight"></div>

                <div id="imageStatus"></div>

                <div id="analysisResult" class="analysis-result"></div>

                <div id="resultButtons" class="result-buttons">
                    <button id="acceptBtn">Aceptar</button>
                    <button id="repeatBtn">Repetir</button>
                </div>

            </div>

        </div>


        <button class="analyze-btn" id="startAnalysis">
            Confirmar inicio de análisis
        </button>



        <!-- LOADING -->
        <div id="loadingSection" class="loading-section">
            <div class="loader"></div>
            <p>Procesando análisis...</p>
        </div>



        <!-- RESUMEN -->
        <h3 class="section-title">Resumen del Análisis</h3>

        <div class="result-section">

            <div class="result-box">
                <h4>Análisis Ojo Izquierdo</h4>
                <textarea></textarea>
            </div>

            <div class="result-box">
                <h4>Análisis Ojo Derecho</h4>
                <textarea id="rightSummary"></textarea>
            </div>

        </div>



        <!-- VALIDACION -->
        <h3 class="section-title">Validación Médica</h3>

        <div class="validation-section">

            <div>
                <label>Recomendación del Modelo</label>
                <select id="modelRecommendation">
                    <option>Retinopatía Diabética no Proliferativa</option>
                </select>
            </div>

            <div>
                <label>Tipo de Retinopatía</label>
                <select>
                    <option>Retinopatía Diabética</option>
                </select>
            </div>

            <div>
                <label>Grado</label>
                <select>
                    <option>Proliferativa</option>
                </select>
            </div>

        </div>


        <div class="observations">

            <div>
                <label>Observaciones clínicas ojo izquierdo</label>
                <textarea></textarea>
            </div>

            <div>
                <label>Observaciones clínicas ojo derecho</label>
                <textarea></textarea>
            </div>

        </div>


        <button class="report-btn">
            Visualizar Reporte
        </button>

    </div>

</div>


<script src="~/js/analysis.js"></script>