@page
@model ProyectoDeGradoFundacion.Pages.Analysis.AnalysisModel

@{
    ViewData["Title"] = "Análisis de Imagen";
    Layout = null;
}

<link rel="stylesheet" href="~/css/analysis.css" />

<div class="layout">

    <!-- SIDEBAR -->
    <div class="sidebar">

        <div class="logo">Clínica</div>

        <div class="menu">
            <a class="menu-btn" asp-page="/Analysis/consultar_citas">
                Consultar citas
            </a>
        </div>

        <form method="post" asp-page="/Login/inicio" asp-page-handler="Logout" class="logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="logout">
                Logout
            </button>
        </form>

    </div>

    <!-- CONTENIDO -->
    <div class="analysis-container" id="reportContent">

        <h2>Análisis de Imagen</h2>

        <div class="info-bar">
            <span id="codigoCita"><b>CITA</b> @Model.CodigoCita</span>
            <span><b>PACIENTE</b> @Model.NombrePaciente</span>
            <span><b>FECHA</b> @Model.Fecha</span>
            <span id="medicoResponsable">
                <b>PERSONA RESPONSABLE</b>
                <span id="medicoResponsableNombre" class="medico-login">@Model.MedicoResponsable</span>
            </span>
        </div>

        <input type="file" id="imageInputLeft" accept="image/jpeg,image/jpg" hidden>
        <input type="file" id="imageInputRight" accept="image/jpeg,image/jpg" hidden>

        <div class="image-section">

            <div class="eye-box">

                <button class="file-btn hide-on-report" onclick="document.getElementById('imageInputLeft').click()">
                    Seleccionar archivo JPEG
                </button>

                <h3>Ojo Izquierdo</h3>

                <div class="image-preview" id="previewLeft"></div>

                <div id="imageStatusLeft"></div>

                <button type="button" class="analyze-btn hide-on-report" id="startAnalysisLeft">
                    Confirmar inicio de análisis
                </button>

                <div id="analysisResultLeft" class="analysis-result"></div>

                <div id="resultButtonsLeft" class="result-buttons">
                    <button id="acceptLeft">Aceptar</button>
                    <button id="repeatLeft">Repetir</button>
                </div>

                <div id="acceptedLabelLeft" class="accepted-label"></div>

            </div>

            <div class="eye-box">

                <button class="file-btn hide-on-report" onclick="document.getElementById('imageInputRight').click()">
                    Seleccionar archivo JPEG
                </button>

                <h3>Ojo Derecho</h3>

                <div class="image-preview" id="previewRight"></div>

                <div id="imageStatusRight"></div>

                <button type="button" class="analyze-btn hide-on-report" id="startAnalysisRight">
                    Confirmar inicio de análisis
                </button>

                <div id="analysisResultRight" class="analysis-result"></div>

                <div id="resultButtonsRight" class="result-buttons">
                    <button id="acceptRight">Aceptar</button>
                    <button id="repeatRight">Repetir</button>
                </div>

                <div id="acceptedLabelRight" class="accepted-label"></div>

            </div>

        </div>

        <div id="loadingSection" class="loading-section">
            <div class="loader"></div>
            <p id="processingText">Procesando análisis...</p>
        </div>

        <h3 class="section-title">Resumen del Análisis</h3>

        <div class="result-section">

            <div class="result-box">
                <h4>Análisis Ojo Izquierdo</h4>
                <div id="summaryLeft" class="summary-content"></div>
            </div>

            <div class="result-box">
                <h4>Análisis Ojo Derecho</h4>
                <div id="summaryRight" class="summary-content"></div>
            </div>

        </div>

        <h3 class="section-title">Validación Médica</h3>

        <div class="validation-area">

            <!-- FILA PRINCIPAL -->
            <div class="validation-row" id="validationRowPrimary" style="display:none;">

                <div class="eye-label-box" id="eyeLabelPrimary">
                    Ojo
                </div>

                <div class="validation-section">

                    <div>
                        <label>Análisis del Médico</label>
                        <select id="modelRecommendation">
                            <option>Retinopatía Diabética no Proliferativa</option>
                            <option>Retinopatía Diabética Proliferativa</option>
                            <option>Retinopatía Hipertensiva</option>
                            <option>Sin signos de retinopatía</option>
                        </select>
                    </div>

                    <div>
                        <label>Tipo de Retinopatía</label>
                        <select id="retinopathyType">
                            <option value="">Seleccionar</option>
                            <option value="diabetica">Retinopatía Diabética</option>
                            <option value="hipertensiva">Retinopatía Hipertensiva</option>
                        </select>
                    </div>

                    <div>
                        <label>Grado</label>
                        <select id="retinopathyGrade" disabled>
                            <option value="">Seleccionar</option>
                        </select>
                    </div>

                </div>

            </div>

            <!-- BOTON + -->
            <div class="add-eye-wrapper hide-on-report" id="addSecondEyeWrapper" style="display:none;">
                <button type="button" class="add-eye-btn" id="btnAddSecondEye">+</button>
            </div>

            <!-- FILA SECUNDARIA -->
            <div class="validation-row" id="validationRowSecondary" style="display:none;">

                <div class="eye-label-box" id="eyeLabelSecondary">
                    Ojo
                </div>

                <div class="validation-section">

                    <div>
                        <label>Análisis del Médico</label>
                        <select id="modelRecommendationSecond">
                            <option>Retinopatía Diabética no Proliferativa</option>
                            <option>Retinopatía Diabética Proliferativa</option>
                            <option>Retinopatía Hipertensiva</option>
                            <option>Sin signos de retinopatía</option>
                        </select>
                    </div>

                    <div>
                        <label>Tipo de Retinopatía</label>
                        <select id="retinopathyTypeSecond">
                            <option value="">Seleccionar</option>
                            <option value="diabetica">Retinopatía Diabética</option>
                            <option value="hipertensiva">Retinopatía Hipertensiva</option>
                        </select>
                    </div>

                    <div>
                        <label>Grado</label>
                        <select id="retinopathyGradeSecond" disabled>
                            <option value="">Seleccionar</option>
                        </select>
                    </div>

                </div>

            </div>

        </div>

        <div class="observations">

            <div>
                <label>Observaciones clínicas ojo izquierdo</label>
                <textarea id="obsLeft"></textarea>
            </div>

            <div>
                <label>Observaciones clínicas ojo derecho</label>
                <textarea id="obsRight"></textarea>
            </div>

        </div>

        <div id="validationInfo" style="margin-top:20px;"></div>

        <button class="report-btn hide-on-report" id="btnReport">
            Visualizar Reporte
        </button>

    </div>

</div>

<div id="imageOverlay"></div>

@Html.AntiForgeryToken()

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="@Url.Content("~/js/analysis.js")"></script>