@page
@model ProyectoDeGradoFundacion.Pages.Analysis.historial_analisisModel

@{
    ViewData["Title"] = "Historial de análisis";
    Layout = null;
}

<link rel="stylesheet" href="~/css/historial.css" />

<div class="layout">

    <div class="sidebar">

        <div class="logo">Clínica</div>

        <div class="menu">

            <a class="menu-btn" asp-page="/Menu/Index">
                Menú
            </a>

            <a class="menu-btn" asp-page="/Analysis/consultar_citas" style="margin-top:10px;">
                Consultar citas
            </a>

        </div>

        <form method="post" asp-page="/Login/inicio" asp-page-handler="Logout" class="logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="logout">
                Logout
            </button>
        </form>

    </div>

    <div class="content">

        <h2>Historial de Análisis Realizados</h2>

        <div id="errorClinic" class="error-box"></div>

        <form method="get">

            <div class="actions">
                <button type="submit" class="primary" id="consultarHistorial">
                    Consultar historial
                </button>

                <a class="secondary" asp-page="/Analysis/historial_analisis">
                    Limpiar filtros
                </a>
            </div>

            <div class="filters">

                <div class="filter-item">
                    <label>Nombre paciente</label>
                    <input type="text" asp-for="FilterNombre" id="filterNombre">
                </div>

                <div class="filter-item">
                    <label>Fecha análisis</label>
                    <input type="date" asp-for="FilterFecha" id="filterFecha">
                </div>

                <div class="filter-item">
                    <label>Resultado</label>
                    <input type="text" asp-for="FilterResultado" id="filterResultado">
                </div>

                <div class="filter-item">
                    <label>Médico responsable</label>
                    <input type="text" asp-for="FilterMedico" id="filterMedico">
                </div>

                <button type="submit" class="search-btn" id="buscarHistorial">
                    Buscar
                </button>

            </div>

        </form>

        <table class="table">

            <thead>
                <tr>
                    <th>CITA</th>
                    <th>PACIENTE</th>
                    <th>DOCUMENTO</th>
                    <th>FECHA ANÁLISIS</th>
                    <th>IMÁGENES</th>
                    <th>RESULTADO</th>
                    <th>MÉDICO</th>
                    <th>PDF</th>
                </tr>
            </thead>

            <tbody id="tablaHistorial">

                @foreach (var cita in Model.Historial)
                {
                    <tr>
                        <td>@cita.CitaExternaId</td>

                        <td>@cita.Usuario.NombreUsuario @cita.Usuario.ApellidoUsuario</td>

                        <td>
                            @cita.Usuario.TipoIdentificacion
                            @cita.Usuario.NumeroIdentificacion
                        </td>

                        <td>@cita.FechaAnalisis?.ToString("yyyy-MM-dd HH:mm")</td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(cita.ImagenOjoIzquierdo))
                            {
                                <a class="view-btn" href="@Url.Content(cita.ImagenOjoIzquierdo)" target="_blank">
                                    OI
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(cita.ImagenOjoDerecho))
                            {
                                <a class="view-btn" href="@Url.Content(cita.ImagenOjoDerecho)" target="_blank">
                                    OD
                                </a>
                            }

                            @if (string.IsNullOrWhiteSpace(cita.ImagenOjoIzquierdo) &&
                                 string.IsNullOrWhiteSpace(cita.ImagenOjoDerecho))
                            {
                                <span style="font-size:11px; color:#6a7883;">Sin imágenes</span>
                            }
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(cita.ResultadoOjoIzquierdo))
                            {
                                <span><strong>OI:</strong> @cita.ResultadoOjoIzquierdo</span><br />
                            }

                            @if (!string.IsNullOrWhiteSpace(cita.ResultadoOjoDerecho))
                            {
                                <span><strong>OD:</strong> @cita.ResultadoOjoDerecho</span>
                            }

                            @if (string.IsNullOrWhiteSpace(cita.ResultadoOjoIzquierdo) &&
                                 string.IsNullOrWhiteSpace(cita.ResultadoOjoDerecho))
                            {
                                <span>Sin resultado</span>
                            }
                        </td>

                        <td>@(string.IsNullOrWhiteSpace(cita.MedicoResponsable) ? "Médico" : cita.MedicoResponsable)</td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(cita.ReportePdf))
                            {
                                <a class="view-btn" href="@Url.Content(cita.ReportePdf)" target="_blank">
                                    Ver PDF
                                </a>
                            }
                            else
                            {
                                <span style="font-size:11px; color:#6a7883;">Sin reporte</span>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Historial.Any())
                {
                    <tr id="noResults" class="no-results">
                        <td colspan="8">
                            No se encontraron análisis con los filtros aplicados
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>